+/// Classifies the result at the DDI signing-request boundary, before device errors are combined.
+/// Request bodies, redirect targets, and non-TSS response bodies are never included.
+#[cfg(feature = "tss")]
+#[doc(hidden)]
+pub fn ddi_signing_response(result: Result<plist::Value, IdeviceError>) -> Result<plist::Value, IdeviceError> {
+    result.map_err(|error| match error {
+        IdeviceError::Socket(io) => IdeviceError::Http(format!(
+            "Apple signing server socket failed ({:?})", io.kind()
+        )),
+        IdeviceError::UnexpectedResponse(text) => match crate::tss::tss_error_status(&text) {
+            Some(crate::tss::TSS_STATUS_NOT_ELIGIBLE) => IdeviceError::UnexpectedResponse(text),
+            Some(status) => IdeviceError::Http(format!(
+                "Apple signing server returned STATUS={status}"
+            )),
+            None => IdeviceError::Http(
+                "Apple signing server returned an unexpected response".into()
+            ),
+        },
+        other => other,
+    })
+}
