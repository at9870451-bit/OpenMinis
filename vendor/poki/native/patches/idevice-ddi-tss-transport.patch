index 163b2dd..d6448a9 100644
--- a/idevice/src/tss.rs
+++ b/idevice/src/tss.rs
@@ -15,10 +15,53 @@ use crate::IdeviceError;
 const TSS_CLIENT_VERSION_STRING: &str = "libauthinstall-1033.0.2";
 /// Apple's TSS endpoint URL
 const TSS_CONTROLLER_ACTION_URL: &str = "http://gs.apple.com/TSS/controller?action=2";
+/// TSS status returned when Apple refuses to sign the requested build for the device.
+pub const TSS_STATUS_NOT_ELIGIBLE: i32 = 94;
+const NON_APPLE_REPLY_PREFIX: &str = "non-Apple TSS reply: ";
+
+#[derive(Debug, Clone, Copy)]
+struct TssFrame<'a> {
+    status: i32,
+    message: &'a str,
+    request_string: Option<&'a str>,
+}
+
+fn parse_tss_frame(body: &str) -> Option<TssFrame<'_>> {
+    let rest = body.trim().strip_prefix("STATUS=")?;
+    let (status, rest) = rest.split_once("&MESSAGE=")?;
+    let status = status.parse::<i32>().ok()?;
+    let (message, request_string) = match rest.split_once("&REQUEST_STRING=") {
+        Some((message, request_string)) => (message, Some(request_string)),
+        None => (rest, None),
+    };
+    Some(TssFrame {
+        status,
+        message,
+        request_string,
+    })
+}
+
+fn non_apple_reply(reason: impl std::fmt::Display) -> IdeviceError {
+    IdeviceError::Http(format!("{NON_APPLE_REPLY_PREFIX}{reason}"))
+}
+
+pub fn is_non_apple_tss_reply(text: &str) -> bool {
+    text.starts_with(NON_APPLE_REPLY_PREFIX)
+}
+
+pub fn tss_error_status(text: &str) -> Option<i32> {
+    if !text.contains("TSS server responded") {
+        return None;
+    }
+    let rest = text.split_once("STATUS=")?.1;
+    let end = rest.find(['&', ')']).unwrap_or(rest.len());
+    rest[..end].parse().ok()
+}

